  abstract = {Resumen En una coyuntura de condiciones cambiantes de migraci\'on y reformulaciones pol\'iticas, la estrategia pol\'itica de migraci\'on de El Salvador, motivada por las remesas, ha visto nuevas contestaciones. Desde los finales de la guerra civil, el estado neoliberal ha promovido la migraci\'on y las remesas a favor de un imaginario desarrollista y particular de ``progreso'' y bienestar ``transnacional.'' Sin embargo, \'ultimamente, los salvadore\~nos enfrentan nuevos desaf\'ios mientras las condiciones de migraci\'on han cambiado y ha crecido la dependencia de El Salvador en la migraci\'on y las remesas. Con un enfoque en las demandas de activistas transnacionales de comunidades de migrantes presentadas en eventos alrededor del cambio del gobierno hacia la izquierda, este art\'iculo examina las maneras en que pol\'iticas, discursos, y l\'ogicas desarrollistas de la migraci\'on transnacional han sido contestados y reimaginados. La articulaci\'on colectiva de estas demandas construyen nuevos imaginarios pol\'iticos de formaciones transnacionales del estado, migraci\'on, y desarrollo.},
  langid = {spanish},
  keywords = {desarrollo,development,economia,economics,El Salvador,migracion,migration,politica,politics},
